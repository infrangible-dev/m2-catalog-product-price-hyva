{
    "name": "infrangible/m2-catalog-product-price-hyva",
    "description": "Makes the price labels, information texts and extra price line of Catalog Product Price work in stores that use the Hyvä theme.",
    "type": "magento2-module",
    "version": "1.0.2",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Hyvä",
        "Pricing",
        "Catalog",
        "Hyvä support for Catalog Product Price",
        "price labels for Hyvä"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-price-hyva",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-catalog-product-price": "~1.2.0",
        "hyva-themes/magento2-default-theme": "*",
        "hyva-themes/magento2-compat-module-fallback": "*"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductPriceHyva\\": "src"
        }
    }
}
